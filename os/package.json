{
  "name": "nirmaan-agency-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "user:create": "tsx scripts/create-user.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "campaigns:worker": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/campaign-worker.ts",
    "campaigns:tick": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/campaign-worker.ts --once"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@prisma/client": "^6.12.0",
    "gray-matter": "^4.0.3",
    "imapflow": "^2.0.7",
    "next": "16.3.5",
    "nodemailer": "^10.0.10",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "^6.12.0",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
