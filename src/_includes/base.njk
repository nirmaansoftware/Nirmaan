{%- set pageOrder -%}index{% for link in navLinks %} {{ link.slug }}{% endfor %}{%- endset -%}
<!DOCTYPE html>
<html lang="en-IN" data-pages="{{ pageOrder }}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

  <title>{{ title | safe }}</title>
  <meta name="description" content="{{ description }}" />
  <meta name="robots" content="{{ robots or 'index, follow' }}" />
  <link rel="canonical" href="{{ site.url }}{{ page.url }}" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="{{ site.name }}" />
  <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
  <meta property="og:title" content="{{ title | safe }}" />
  <meta property="og:description" content="{{ ogDescription or description }}" />
  <meta property="og:image" content="{{ site.url }}/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="The Nirmaan pixel-N mark beside the line: We build software, block by block." />
  <meta name="twitter:card" content="summary_large_image" />
  {%- if site.social.x %}
  <meta name="twitter:site" content="@{{ site.social.x | replace('https://x.com/', '') }}" />
  {%- endif %}
  <meta name="twitter:title" content="{{ title | safe }}" />
  <meta name="twitter:description" content="{{ ogDescription or description }}" />
  <meta name="twitter:image" content="{{ site.url }}/og-image.png" />

  <meta name="color-scheme" content="light dark" />
  <meta name="theme-color" content="#F1F1EC" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0E0E0F" media="(prefers-color-scheme: dark)" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  {%- if nav == 'home' %}
  {#- Who we are, for search engines: name, logo, contact and profiles. #}
  {%- set sameAs = [] %}
  {%- for url in [site.social.linkedin, site.social.github, site.social.x] %}{% if url %}{% set sameAs = (sameAs.push(url), sameAs) %}{% endif %}{% endfor %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "{{ site.url }}/#organization",
        "name": {{ site.name | dump | safe }},
        "description": {{ description | dump | safe }},
        "url": "{{ site.url }}/",
        "logo": "{{ site.url }}/apple-touch-icon.png"
        {%- if site.email %},
        "email": {{ site.email | dump | safe }}{% endif %}
        {%- if sameAs.length %},
        "sameAs": {{ sameAs | dump | safe }}{% endif %}
      },
      {
        "@type": "WebSite",
        "@id": "{{ site.url }}/#website",
        "name": {{ site.name | dump | safe }},
        "url": "{{ site.url }}/",
        "publisher": { "@id": "{{ site.url }}/#organization" }
      }
    ]
  }
  </script>
  {%- endif %}

  {#- Runs before first paint: applies a saved theme choice, and marks the page as
      able to animate. Content is only ever hidden for a reveal when .motion is
      set, so with no JS or with reduced motion every section renders at rest. #}
  <script>
    (function () {
      var root = document.documentElement;
      try {
        var saved = localStorage.getItem('nirmaan-theme');
        if (saved === 'light' || saved === 'dark') root.setAttribute('data-theme', saved);
      } catch (e) {}
      root.classList.add('js');
      if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        root.classList.add('motion');
      }
    })();
  </script>

  {#- Fonts are self-hosted (assets/fonts, OFL), so the first paint never waits on a third party. #}
  <link rel="preload" href="/assets/fonts/archivo.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/assets/fonts/hanken-grotesk.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/assets/fonts/jetbrains-mono.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/styles.css" />

  {#- The page-transition mask, fetched early so the first transition never waits for it. #}
  <link rel="preload" href="/assets/motion/build-landscape.svg" as="image" type="image/svg+xml" media="(orientation: landscape)" />
  <link rel="preload" href="/assets/motion/build-portrait.svg" as="image" type="image/svg+xml" media="(orientation: portrait)" />
  {#- Fetch a page as soon as someone shows intent (hover or touch), so it opens instantly. #}
  <script type="speculationrules">{"prefetch": [{"where": {"and": [{"href_matches": "/*"}, {"not": {"href_matches": "/*.xml"}}]}, "eagerness": "moderate"}]}</script>
  <script src="/page-transitions.js"></script>
  <script src="/site.js" defer></script>
  {%- for script in scripts %}
  <script src="/{{ script }}" defer></script>
  {%- endfor %}
</head>
<body class="page page--{{ nav }}" id="top">

<a class="skip-link" href="#main">Skip to content</a>

{% include "nav.njk" %}

<main id="main" tabindex="-1">
{%- if head %}
{% include "page-head.njk" %}
{%- endif %}
{{ content | safe }}
{%- if cta %}
{% include "cta.njk" %}
{%- endif %}
</main>

{% include "footer.njk" %}

{#- Phones: the next step stays within thumb reach once the page's own
    buttons have scrolled away (site.js shows and hides it). -#}
{%- if nav != 'contact' %}
<div class="dock" data-dock aria-label="Quick actions" role="region">
  <a class="btn dock__cta" href="/contact.html">Tell us your problem {% glyph "00100/00010/11111/00010/00100", "btn__arrow" %}</a>
  {%- if nav == 'pricing' %}
  <a class="dock__link" href="/pricing.html#estimator">Estimate</a>
  {%- else %}
  <a class="dock__link" href="/pricing.html">Pricing</a>
  {%- endif %}
</div>
{%- endif %}

</body>
</html>
