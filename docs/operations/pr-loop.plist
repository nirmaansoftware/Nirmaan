<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The automated PR loop for nirmaansoftware/Nirmaan, run by launchd every
  5 minutes on the founder's Mac. Install and remove: docs/operations/pr-review.md
  ("Automated loop"). Each run updates a dedicated clone to origin/main and
  runs main's copy of the loop once; launchd never starts a second run while
  one is still going, and the loop's lock is shared with ip-nirmaan.
  It uses the Mac's own `claude` login (the plan) and `gh` login. No secret
  is stored here or in GitHub Actions.
  Settings (PATH and the review App's variables) are not in this file: the
  command sources ~/.nirmaan/pr-loop/env first, so copying a new version of
  this plist keeps them. That file holds paths and IDs only, never a key's
  contents. Without it the run stops and says so in the log.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>online.nirmaan.pr-loop</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>mkdir -p "$HOME/.nirmaan/pr-review" &amp;&amp; { . "$HOME/.nirmaan/pr-loop/env" &amp;&amp; cd "$HOME/.nirmaan/pr-loop/Nirmaan" &amp;&amp; git fetch --quiet origin main &amp;&amp; git -c core.hooksPath=/dev/null reset --quiet --hard origin/main &amp;&amp; node .github/scripts/pr-loop/pr-loop.mjs --once; } &gt;&gt; "$HOME/.nirmaan/pr-review/loop.log" 2&gt;&amp;1</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
