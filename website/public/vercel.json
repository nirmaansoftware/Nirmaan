{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/agency-os.html", "destination": "/process.html#honest", "permanent": true },
    { "source": "/agency-os", "destination": "/process.html#honest", "permanent": true },
    { "source": "/pricing/care/growth.html", "destination": "/pricing/care/plus.html", "permanent": true },
    { "source": "/pricing/care/growth", "destination": "/pricing/care/plus.html", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
