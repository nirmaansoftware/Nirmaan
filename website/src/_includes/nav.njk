<header class="nav" id="navbar" data-nav>
  <div class="wrap nav__inner">
    <a class="brand" href="/" aria-label="{{ site.name }}, home"{% if nav == 'home' %} aria-current="page"{% endif %}>
      {% logo "brand__mark" %}
      <span class="brand__word">{{ site.name }}</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      <ul role="list">
        {%- for link in navLinks %}{% if link.slug != 'contact' %}
        <li><a href="/{{ link.href }}"{% if nav == link.slug %} aria-current="page"{% endif %}>{{ link.label }}</a></li>
        {%- endif %}{% endfor %}
      </ul>
    </nav>

    <div class="nav__actions">
      <button class="theme-toggle" type="button" data-theme-toggle data-mode="system" aria-label="Colour theme: match system">
        {% glyph "11111/11001/11001/11001/11111", "theme-toggle__icon theme-toggle__icon--system" %}
        {% glyph "10101/01110/11011/01110/10101", "theme-toggle__icon theme-toggle__icon--light" %}
        {% glyph "01110/11100/11000/11100/01110", "theme-toggle__icon theme-toggle__icon--dark" %}
      </button>
      <a class="btn btn--sm nav__cta" href="/contact.html">Tell us your problem {% glyph "00100/00010/11111/00010/00100", "btn__arrow" %}</a>
      <button class="nav__burger" type="button" data-menu-toggle aria-expanded="false" aria-controls="menu">
        <span class="visually-hidden">Menu</span>
        <span class="nav__burger-bar" aria-hidden="true"></span>
        <span class="nav__burger-bar" aria-hidden="true"></span>
      </button>
    </div>
  </div>
  <div class="nav__progress" data-scroll-progress aria-hidden="true"></div>
</header>

<div class="menu" id="menu" data-menu hidden>
  <nav class="wrap menu__inner" aria-label="Mobile">
    <ul class="menu__links" role="list">
      <li><a href="/"{% if nav == 'home' %} aria-current="page"{% endif %}>Home</a></li>
      {%- for link in navLinks %}
      <li><a href="/{{ link.href }}"{% if nav == link.slug %} aria-current="page"{% endif %}>{{ link.label }}</a></li>
      {%- endfor %}
    </ul>
    <div class="menu__foot">
      <a class="btn menu__cta" href="/contact.html">Tell us your problem {% glyph "00100/00010/11111/00010/00100", "btn__arrow" %}</a>
      {%- if site.email %}<p class="mono">{{ site.email }}</p>{% endif %}
      <p class="mono">{{ site.name }} · {{ site.descriptor }}</p>
    </div>
  </nav>
</div>
