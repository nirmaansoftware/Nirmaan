<footer class="footer">
  <div class="wrap">
    <div class="footer__grid">
      <div class="footer__brand">
        <a class="brand brand--lockup" href="/" aria-label="{{ site.name }} {{ site.descriptor }}, home">
          {% logo "brand__mark" %}
          <span class="brand__stack">
            <span class="brand__word">{{ site.name }}</span>
            <span class="brand__descriptor">{{ site.descriptor }}</span>
          </span>
        </a>
        <p class="footer__blurb">Websites, web applications and the backend systems behind them, built as one system around how your business runs.</p>
        {%- set socials = [["LinkedIn", site.social.linkedin], ["GitHub", site.social.github], ["X · @" + (site.social.x | replace("https://x.com/", "")), site.social.x]] %}
        <ul class="footer__social" role="list">
          {%- for s in socials %}{% if s[1] %}
          <li><a href="{{ s[1] }}" rel="noopener noreferrer" target="_blank">{{ s[0] }}<span class="visually-hidden"> (opens in a new tab)</span></a></li>
          {%- endif %}{% endfor %}
        </ul>
      </div>

      <nav class="footer__col" aria-label="Services">
        <p class="footer__heading mono">Services</p>
        <ul role="list">
          {%- for f in services.featured %}
          <li><a href="/services/{{ f.id }}.html">{{ f.title }}</a></li>
          {%- endfor %}
        </ul>
      </nav>

      <nav class="footer__col" aria-label="Studio">
        <p class="footer__heading mono">Studio</p>
        <ul role="list">
          <li><a href="/">Home</a></li>
          {%- for link in navLinks %}
          <li><a href="/{{ link.href }}">{{ link.label }}</a></li>
          {%- endfor %}
        </ul>
      </nav>

      <div class="footer__col">
        <p class="footer__heading mono">Start</p>
        <ul role="list">
          <li><a href="/contact.html">Tell us your problem</a></li>
          <li><a href="/pricing.html">Pricing &amp; estimator</a></li>
          {%- if site.email %}<li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>{% endif %}
          {%- if site.whatsapp %}<li><a href="https://wa.me/{{ site.whatsapp }}" target="_blank" rel="noopener noreferrer">WhatsApp us <span aria-hidden="true">↗</span><span class="visually-hidden">(opens WhatsApp)</span></a></li>{% endif %}
          <li><a href="https://sudaangeo.in" target="_blank" rel="noopener noreferrer">See our work live <span aria-hidden="true">↗</span><span class="visually-hidden">(sudaangeo.in, opens in a new tab)</span></a></li>
        </ul>
      </div>
    </div>

    <div class="footer__base mono">
      <span>© {{ build.year }} {{ site.name }}</span>
      <span>Built block by block</span>
      <span class="footer__legal"><a href="/privacy.html">Privacy</a> <a href="/terms.html">Terms</a></span>
      <a href="#top" class="footer__top" data-to-top>Back to top <span aria-hidden="true">↑</span></a>
    </div>
  </div>
</footer>
