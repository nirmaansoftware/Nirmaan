<section class="section" aria-label="Technology by layer">
  <div class="wrap stacks">
    {%- for stack in stacks %}
    <section class="spec" aria-labelledby="stack-{{ loop.index }}" data-reveal style="--d: {{ loop.index0 % 2 }}">
      <header class="spec__head">
        {% glyph stack.glyph %}
        <h2 class="spec__title" id="stack-{{ loop.index }}">{{ stack.name }}</h2>
        <p class="spec__sub">{{ stack.sub }}</p>
      </header>
      <dl>
        {%- for item in stack.items %}
        <div><dt>{{ item[0] }}</dt><dd>{{ item[1] }}</dd></div>
        {%- endfor %}
      </dl>
    </section>
    {%- endfor %}
  </div>
</section>

<section class="section" aria-labelledby="principle-title">
  <div class="wrap statement" data-reveal>
    {% glyph "00100/01110/11111/01110/00100" %}
    <div>
      <p class="eyebrow">How we choose</p>
      <h2 class="statement__title display" id="principle-title">Technology chosen for the project. Not the other way&nbsp;around.</h2>
      <p>We don't force every project into the same stack. A simple business website doesn't need a heavy framework; a large web application does need the right backend architecture. We recommend the tools that fit your requirements and your long-term plans.</p>
