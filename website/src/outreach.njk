<section class="section" aria-labelledby="guards-title">
  <div class="wrap mk-split">
    <div data-reveal>
      <p class="eyebrow">Built in, not optional</p>
      <h2 class="section__title display" id="guards-title">Outreach that protects your&nbsp;name.</h2>
