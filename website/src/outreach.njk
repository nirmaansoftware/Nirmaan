</section>

<section class="section section--tint" id="price" aria-labelledby="price-title">
  <div class="wrap mk-split">
    <div data-reveal>
      <p class="eyebrow">Price · Early access</p>
      <h2 class="section__title display" id="price-title">One plan, priced up&nbsp;front.</h2>
